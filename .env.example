# VITE_WORKER_URL: Cloudflare Worker URL (HTTP/HTTPS or WS/WSS).
# Local development with Wrangler:
VITE_WORKER_URL="http://127.0.0.1:8787"

# Production Cloudflare Worker deployment (uncomment and set after `wrangler deploy`):
# VITE_WORKER_URL="https://ball-vs-ball-worker.YOUR_SUBDOMAIN.workers.dev"

# Optional Google OAuth 2.0 Web Client ID (Google Cloud Console -> Authorized JS origins: localhost + github.io)
# VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
