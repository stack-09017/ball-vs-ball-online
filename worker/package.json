{
  "name": "ball-vs-ball-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create ball-vs-ball-db",
    "db:migrate:local": "wrangler d1 execute ball-vs-ball-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute ball-vs-ball-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  }
}
